{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "plugins": ["html"],
  "rules": {
    "no-unused-vars": ["error", { "args": "all" }],
    "no-undef": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-func-assign": "error",
    "no-const-assign": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "no-empty": "warn",
    "valid-typeof": "error",
    "eqeqeq": ["error", "always"],
    "curly": "error",
    "no-var": "warn",
    "prefer-const": "warn",
    "no-console": "off"
  }
}
